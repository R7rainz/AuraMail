# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Database
# Host dev: use localhost + published port (5433). Inside Docker Compose the service sets DATABASE_URL to host postgres:5432.
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://ai_email_user:change_me@localhost:5433/ai_email

# Google OAuth Credentials
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# JWT Secrets (Generate these using: openssl rand -base64 32)
JWT_SECRET=generate_with_openssl_rand_base64_32
JWT_REFRESH_SECRET=generate_with_openssl_rand_base64_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Callback URL
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Gmail API Credentials (Different from OAuth)
GMAIL_CLIENT_ID=your_gmail_api_client_id
GMAIL_CLIENT_SECRET=your_gmail_api_client_secret
GMAIL_REDIRECT_URI=http://localhost:8080/auth/gmail/callback

# Application
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Client ID (for token verification)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Goose migrations
GOOSE_DBSTRING="user=ai_email_user password=change_me host=localhost port=5433 dbname=ai_email sslmode=disable"
GOOSE_DRIVER=postgres
GOOSE_DIR=./migrations
